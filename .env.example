# =============================================================
# Snowflake Connection Settings
# =============================================================
SF_ACCOUNT=myaccount.us-east-1
SF_USER=myuser
SF_PASSWORD=mypassword
SF_WAREHOUSE=COMPUTE_WH
SF_DATABASE=MYDB
SF_SCHEMA=PUBLIC
SF_ROLE=SYSADMIN

# Alternative: Key-pair auth
# SF_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
# SF_PRIVATE_KEY_PASSPHRASE=mypassphrase

# Alternative: SSO
# SF_AUTHENTICATOR=externalbrowser

# Alternative: OAuth
# SF_AUTHENTICATOR=oauth
# SF_TOKEN=myoauthtoken

# =============================================================
# Databricks Connection Settings
# =============================================================
DB_HOST=myworkspace.azuredatabricks.net
DB_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxx
DB_ACCESS_TOKEN=dapixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Unity Catalog target
DB_CATALOG=main
DB_SCHEMA=migrated

# =============================================================
# Claude / Anthropic API
# =============================================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
